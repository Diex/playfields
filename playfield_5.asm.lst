    134  f079							;---------------------------------------
    135  f079		       e8		      inx
    136  f07a		       e0 1e		      cpx	#30	;		compare value in (x) to immeadiate value of 30
    137  f07c		       d0 f9		      bne	overscan	;		branch up to 'overscan' label, compare if not equal
    138  f07e		       e6 82		      inc	fcount
