------- FILE playfield_5.asm
     20  0000 ????
     21  0000 ????	       00 9a	   BLUE       =	$9a	;		define symbol for TIA color (NTSC)
     22  0000 ????	       00 3c	   changeColorSpeed =	60	; frames to change color
     23  0000 ????	       00 0c	   lineCountChange =	192/16	; lines to change playfield
     24  0000 ????
     25 U0085 ????				      seg.u	vars	; uninitialized segment
     26 U0080					      org	$80	; origin set at base of ram
     27 U0080
     28 U0080		       00	   r_seed     ds	1	; ball x pos
     29 U0081		       00	   l_seed     ds	1	; ball y pos
     30 U0082		       00	   fcount     ds	1	; frame counter
     31 U0083		       00	   bgcolor    ds	1	; background color
     32 U0084		       00	   lcount     ds	1	; line counter
     33 U0085
     34  10000 ????				       seg	code
     35  f000					      org	$f000
     36  f000
     37  f000				   reset
      0  f000					      CLEAN_START
      1  f000		       78		      sei
      2  f001		       d8		      cld
      3  f002
      4  f002		       a2 00		      ldx	#0
      5  f004		       8a		      txa
      6  f005		       a8		      tay
      7  f006		       ca	   .CLEAR_STACK dex
      8  f007		       9a		      txs
      9  f008		       48		      pha
     10  f009		       d0 fb		      bne	.CLEAR_STACK
     11  f00b
     39  f00b							; generate a random see from the interval timer
     40  f00b		       ad 84 02 	      lda	INTIM	; unknown value to use as an initial random seed
     41  f00e		       85 80		      sta	r_seed	; random seed
     42  f010		       85 81		      sta	l_seed	; random seed
     43  f012
     44  f012				   clear		;		define a label
     45  f012		       a9 9a		      lda	#BLUE	;		load the value from the symbol 'blue' into (a)
     46  f014		       85 09		      sta	COLUBK	;		store (a) into the TIA background color register
     47  f016		       a9 03		      lda	#%00000011	; Set D0 to reflect the playfield, and D1 for Two color
     48  f018		       85 0a		      sta	CTRLPF	; Apply to the CTRLPF register
     49  f01a
     50  f01a		       a9 00		      lda	#PLAYER0COLOR
     51  f01c		       85 06		      sta	COLUP0
     52  f01e		       a9 00		      lda	#PLAYER1COLOR
     53  f020		       85 07		      sta	COLUP1
     54  f022				   startFrame
     55  f022
     56  f022							; start of new frame
     57  f022							; start of vertical blank processing
     58  f022		       a9 00		      lda	#0	;		load the value 0 into (a)
     59  f024		       85 01		      sta	VBLANK	;		store (a) into the TIA VBLANK register
     60  f026		       85 0d		      sta	PF0
     61  f028		       85 0e		      sta	PF1
     62  f02a		       85 0f		      sta	PF2
     63  f02c		       85 09		      sta	COLUBK
     64  f02e
     65  f02e		       a9 02		      lda	#2	;		load the value 2 into (a).
     66  f030		       85 00		      sta	VSYNC	;		store (a) into TIA VSYNC register to turn on vsync
     67  f032
     68  f032		       85 02		      sta	WSYNC	;		write any value to TIA WSYNC register to wait for hsync
     69  f034		       85 02		      sta	WSYNC
     70  f036		       85 02		      sta	WSYNC	;		we need 3 scanlines of VSYNC for a stable frame
     71  f038
     72  f038							;---------------------------------------
     73  f038		       a9 00		      lda	#0
     74  f03a		       85 00		      sta	VSYNC	;		store 0 into TIA VSYNC register to turn off vsync
     75  f03c
     76  f03c							;---------------------------------------
     77  f03c							; generate 37 scanlines of vertical blank
     78  f03c		       a2 00		      ldx	#0
     79  f03e				   verticalBlank
     80  f03e		       85 02		      sta	WSYNC	;		write any value to TIA WSYNC register to wait for hsync
     81  f040		       e8		      inx
     82  f041		       e0 25		      cpx	#37	;		compare the value in (x) to the immeadiate value of 37
     83  f043		       d0 f9		      bne	verticalBlank	;		branch to 'verticalBlank' label if compare not equal
     84  f045							;---------------------------------------
     85  f045
     86  f045		       a5 83		      lda	bgcolor
     87  f047		       85 09		      sta	COLUBK
     88  f049
     89  f049		       a2 00		      ldx	#0	; counter for lines
     90  f04b		       20 8d f0 	      jsr	setPlayfield
     91  f04e
     92  f04e							; lda l_seed
     93  f04e							; sta r_seed
     94  f04e
     95  f04e
     96  f04e		       a5 82		      lda	fcount
     97  f050		       c9 3c		      cmp	#changeColorSpeed
     98  f052		       d0 07		      bne	playfield
     99  f054		       20 9d f0 	      jsr	changeBackground
    100  f057
    101  f057		       a9 00		      lda	#0
