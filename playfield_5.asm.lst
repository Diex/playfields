    110  f05d
    111  f05d		       e6 84		      inc	lcount
    112  f05f		       a5 84		      lda	lcount
    113  f061		       c9 0c		      cmp	#lineCountChange
    114  f063		       d0 07		      bne	noChangeColor
    115  f065
    116  f065		       20 8d f0 	      jsr	setPlayfield
    117  f068		       a9 00		      lda	#0
    118  f06a		       85 84		      sta	lcount
